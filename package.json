{
  "name": "@animalfox/lexicon-gate",
  "version": "1.0.0",
  "private": true,
  "description": "Dual-list lexicon moderation for chat text.",
  "homepage": "https://github.com/Animalfox/LexiconGate",
  "bugs": {
    "url": "https://github.com/Animalfox/LexiconGate/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Animalfox",
    "email": "95981a@gmail.com",
    "url": "https://github.com/Animalfox"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Animalfox/LexiconGate.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "oxlint && oxfmt --check",
    "check:fix": "oxfmt && oxlint --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint-plugin-jsdoc": "65.4.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
