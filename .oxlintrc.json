{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vitest"],
  "jsPlugins": [
    {
      "name": "jsdoc-js",
      "specifier": "eslint-plugin-jsdoc"
    }
  ],
  "settings": {
    "jsdoc": {
      "tagNamePreference": {
        "fileoverview": "file",
        "overview": "file",
        "module": false
      }
    }
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "jsdoc-js/require-file-overview": "error",
    "jsdoc-js/check-tag-names": "error"
  },
  "env": {
    "builtin": true
  }
}
